<UserControl x:Class="JVoice.App.UI.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="460" Height="470" Background="Transparent"
             FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Text.Primary}"
             TextOptions.TextFormattingMode="Display">
    <!-- ===== The first-run Welcome window (parity §10.2; Mac UI/WelcomeWindow.swift, 460 × 470) =====
         New users only (TourAudience). Page 1 — what JVoice does + the microphone's privacy status;
         page 2 — "You're all set!" with the LIVE shortcut cheat sheet and, for a new user who hasn't
         answered, "Want a quick tour?" (Show Me Around / No Thanks). The bottom area has a fixed height so
         answering never moves the tour's anchors (welcome.shortcut, welcome.tryIt) above it. -->
    <Grid Margin="36,16,36,24">
        <!-- ⓘ (Replay Tour · Show Me ▸ · Keyboard Shortcuts), added in code at the top-right -->
        <ContentControl x:Name="InfoHost" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,-24,0"
                        AutomationProperties.AutomationId="welcome.help" Panel.ZIndex="1" />

        <!-- Page 1 — welcome + permissions -->
        <DockPanel x:Name="PermissionsPage" Margin="0,24,0,0"
                   Visibility="{Binding IsPermissionsPage, Converter={StaticResource BoolToVis}}">
            <Button DockPanel.Dock="Bottom" Content="Continue" Style="{StaticResource AccentButton}" IsDefault="True"
                    MinWidth="160" Padding="16,7" FontSize="13" HorizontalAlignment="Center" Click="OnContinue" />
            <StackPanel>
                <Image x:Name="AppIcon" Width="64" Height="64"
                       RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="JVoice" />
                <TextBlock Text="Welcome to JVoice" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,14,0,0" />
                <TextBlock Foreground="{DynamicResource Text.Secondary}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,8,0,0" Text="{Binding Intro}" />

                <Border Background="{DynamicResource Card.Fill}" BorderBrush="{DynamicResource Card.Hairline}" BorderThickness="1"
                        CornerRadius="12" Margin="0,22,0,0">
                    <StackPanel>
                        <Grid Margin="14,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE720;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="6,0,8,0">
                                <TextBlock Text="Microphone" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="To hear what you say." Style="{StaticResource Note}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding MicrophoneAllowed, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="&#xE930;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Foreground="{DynamicResource Success}" VerticalAlignment="Center" />
                                <TextBlock Text="Allowed" Foreground="{DynamicResource Text.Secondary}" FontSize="12" Margin="6,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="Open Settings" Style="{StaticResource SubtleButton}" Click="OnOpenMicSettings"
                                    Visibility="{Binding MicrophoneAllowed, Converter={StaticResource InverseBoolToVis}}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Card.Hairline}" Margin="14,0" />
                        <Grid Margin="14,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="6,0,8,0">
                                <TextBlock Text="Typing into apps" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="No permission needed on Windows." Style="{StaticResource Note}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE930;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Foreground="{DynamicResource Success}" VerticalAlignment="Center" />
                                <TextBlock Text="Ready" Foreground="{DynamicResource Text.Secondary}" FontSize="12" Margin="6,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <TextBlock Text="Recommended. You can change this later in Windows Settings." Style="{StaticResource Note}"
                           HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Page 2 — all set (+ the tour question) -->
        <DockPanel x:Name="AllSetPage" Margin="0,20,0,0"
                   Visibility="{Binding IsPermissionsPage, Converter={StaticResource InverseBoolToVis}}">
            <Grid DockPanel.Dock="Bottom" Height="118" Visibility="{Binding PendingQuestion, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Bottom">
                    <Border Height="1" Width="300" Background="{DynamicResource Card.Hairline}" />
                    <TextBlock Text="Want a quick tour?" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock Text="We'll point out each part the first time you use it. You can skip any time."
                               Style="{StaticResource Note}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                        <Button Content="No Thanks" Style="{StaticResource SubtleButton}" IsCancel="True" MinWidth="130" Padding="14,7"
                                FontSize="13" Click="OnNoThanks" />
                        <Button Content="Show Me Around" Style="{StaticResource AccentButton}" IsDefault="True" MinWidth="150" Padding="14,7"
                                FontSize="13" Margin="12,0,0,0" Click="OnShowMeAround" />
                    </StackPanel>
                </StackPanel>
            </Grid>
            <!-- Centred in the fixed page height, so the spare room isn't one empty band above the button (round 3 JV #5). -->
            <StackPanel VerticalAlignment="Center">
                <!-- A vector check circle (a font glyph this large rendered stair-stepped — round 2 JV #7). -->
                <Grid Width="44" Height="44" HorizontalAlignment="Center">
                    <Ellipse Stroke="{DynamicResource Success}" StrokeThickness="2.5" Margin="1.25" />
                    <Path Data="M 13.5,22.5 L 19.5,28.5 L 31,16.5" Stroke="{DynamicResource Success}" StrokeThickness="2.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Grid>
                <TextBlock Text="You're all set!" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,12,0,0" />
                <TextBlock Text="JVoice lives in your tray, by the clock. Your shortcuts:" Foreground="{DynamicResource Text.Secondary}"
                           FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,0" />

                <StackPanel HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Grid AutomationProperties.AutomationId="welcome.shortcut" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border HorizontalAlignment="Right" Background="{DynamicResource Input.Fill}" BorderBrush="{DynamicResource Card.Hairline}"
                                BorderThickness="1" CornerRadius="5" Padding="8,3">
                            <TextBlock Text="{Binding ToggleShortcut}" FontSize="12" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="Start / stop dictation" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,8,0,0" Visibility="{Binding HasUndoShortcut, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border HorizontalAlignment="Right" Background="{DynamicResource Input.Fill}" BorderBrush="{DynamicResource Card.Hairline}"
                                BorderThickness="1" CornerRadius="5" Padding="8,3">
                            <TextBlock Text="{Binding UndoShortcut}" FontSize="12" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="Undo last paste" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>

                <Border HorizontalAlignment="Center" Margin="0,16,0,0" Padding="10,6" Background="Transparent"
                        AutomationProperties.AutomationId="welcome.tryIt">
                    <StackPanel>
                        <TextBlock Text="{Binding TryIt}" FontSize="13" FontWeight="Medium" TextWrapping="Wrap" TextAlignment="Center" />
                        <!-- A box to try it in right here (review round 1 JV #6/#7): dictation pastes into it while it
                             has the keyboard — VoiceCoordinator asks WelcomeWindow.AcceptsDictation — instead of into the
                             last other app, and it fills the space above the buttons. -->
                        <Grid Width="300" Margin="0,10,0,0">
                            <TextBox x:Name="TryBox" Style="{StaticResource InputBox}" Height="84" TextWrapping="Wrap"
                                     AcceptsReturn="True" VerticalContentAlignment="Top" AutomationProperties.Name="Try dictating here" />
                            <TextBlock Text="Click here, then talk" FontSize="13" Foreground="{DynamicResource Text.Tertiary}"
                                       Margin="10,7,0,0" IsHitTestVisible="False" VerticalAlignment="Top">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TryBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>
                <!-- Without the tour question the button follows the content, and the block centres in the page. -->
                <Button Content="Start Dictating" Style="{StaticResource AccentButton}" MinWidth="160" Padding="16,7" FontSize="13"
                        HorizontalAlignment="Center" Margin="0,26,0,0" Click="OnStartDictating"
                        Visibility="{Binding PendingQuestion, Converter={StaticResource InverseBoolToVis}}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
