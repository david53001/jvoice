<UserControl x:Class="JVoice.App.UI.HudView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Grayscale"
             RenderOptions.BitmapScalingMode="HighQuality">
    <!-- ===== The glass pill (parity row 29; Mac HUDView.swift + HUDLayout.swift) =====
         ONE capsule (height 56, radius 28) wraps whichever pill is showing and hugs it: the
         recording/transcribing row is at least 240 wide, a status pill is as wide as its text
         (wrapping to two lines beyond 360). A visible pill replacing a visible pill MORPHS — the
         capsule's width eases (300 ms, no bounce) while the contents cross-fade; the first show and
         the hide never animate (latency contract, §7 #49).

         Surface: the Pill.Backing brush (a dark backing at the Opacity setting's pill alpha — the
         pill keeps a dark appearance in both themes, like the Mac's) with a 1 px 10 % hairline, and
         ONE soft shadow drawn OUTSIDE the capsule only (its Clip cuts the capsule out), so nothing
         shadows through the translucent body. No glow. A layered window has no blur behind it, so
         the backing carries the contrast (UiOpacity's Windows pill anchors).

         The panel is a fixed 404×100 (the widest capsule + a 22 margin for the shadow); the capsule
         is bottom-anchored and centred, so a morph never moves its bottom edge or centre.
         HudRootScale (LayoutTransform) enlarges everything by DisplayMetrics.HudScale so it stays crisp
         when the desktop runs below native resolution. Text uses Ideal formatting: Display-mode glyphs
         are hinted at the untransformed size and go stair-stepped under that scale (review round 1
         JV #1); Ideal outlines scale cleanly, and Grayscale is what a layered window renders anyway. -->
    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="HudRootScale" ScaleX="1.0" ScaleY="1.0" />
        </Grid.LayoutTransform>
        <Grid Width="404" Height="100">
            <!-- the one soft shadow (radius 10, 4 down), clipped to outside the capsule -->
            <Border x:Name="Shadow" CornerRadius="28" Background="#FF000000"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="22"
                    Width="{Binding ActualWidth, ElementName=Capsule}" Height="{Binding ActualHeight, ElementName=Capsule}"
                    IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.22" />
                </Border.Effect>
            </Border>

            <Border x:Name="Capsule" CornerRadius="28" MinHeight="56" MinWidth="56"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="22"
                    Background="{DynamicResource Pill.Backing}" BorderBrush="#1AFFFFFF" BorderThickness="1"
                    AutomationProperties.AutomationId="pill.controls">
                <Grid x:Name="Contents">

                    <!-- Recording / transcribing: J mark · waveform bars · red stop (recording only) -->
                    <StackPanel x:Name="LivePanel" Orientation="Horizontal" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Margin="16,0">
                        <TextBlock Text="J" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="19" FontWeight="Black"
                                   Foreground="#FFFFFFFF" Width="18" TextAlignment="Center" VerticalAlignment="Center" />
                        <!-- 15 thin capsules (added in code) resting as a calm flat line (2 px), never dots -->
                        <StackPanel x:Name="Bars" Orientation="Horizontal" Height="26" Margin="14,0"
                                    VerticalAlignment="Center" />
                        <Grid Width="22" Height="22" VerticalAlignment="Center">
                            <Button x:Name="StopButton" Cursor="Hand" ToolTip="Stop recording" Focusable="False"
                                    AutomationProperties.Name="Stop recording" Click="OnStopClick">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid x:Name="Root">
                                            <Border CornerRadius="6" Background="#FFE5484D" />
                                            <Border Width="8" Height="8" CornerRadius="2" Background="#FFFFFFFF" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Root" Property="Opacity" Value="0.7" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Status (Pasted / Copied / an error): the symbol in its meaning colour + callout text -->
                    <StackPanel x:Name="StatusPanel" Orientation="Horizontal" Visibility="Collapsed" Opacity="0"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,8,20,8">
                        <TextBlock x:Name="StatusIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                   Width="20" TextAlignment="Center" VerticalAlignment="Center" Text="&#xE73E;" />
                        <TextBlock x:Name="StatusText" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" FontWeight="Medium"
                                   Foreground="#FFFFFFFF" Margin="10,0,0,0" VerticalAlignment="Center"
                                   MaxWidth="294" MaxHeight="40" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   Text="Pasted" />
                    </StackPanel>

                    <!-- Model work (preparing / downloading): blue icon · title · detail · progress -->
                    <StackPanel x:Name="ModelPanel" Orientation="Horizontal" Visibility="Collapsed" Opacity="0"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,6,20,6">
                        <TextBlock x:Name="ModelIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                   Foreground="#FF60CDFF" Width="20" TextAlignment="Center" VerticalAlignment="Center" Text="&#xE713;" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ModelTitle" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#FFFFFFFF" Text="Preparing Model" />
                            <TextBlock x:Name="ModelDetail" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12"
                                       Foreground="#C5FFFFFF" Typography.NumeralAlignment="Tabular" Text="One-time setup — keep JVoice open" />
                            <Border x:Name="ModelTrack" Width="150" Height="4" CornerRadius="2" Background="#1AFFFFFF"
                                    HorizontalAlignment="Left" Margin="0,4,0,0" ClipToBounds="True">
                                <Border x:Name="ModelFill" HorizontalAlignment="Left" Width="0" CornerRadius="2" Background="#FF60CDFF" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
