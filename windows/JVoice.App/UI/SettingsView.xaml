<UserControl x:Class="JVoice.App.UI.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:JVoice.App.UI"
             Width="1080" Background="Transparent"
             FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Text.Primary}"
             TextOptions.TextFormattingMode="Display">
    <!-- ===== The native-look Settings (parity row 28; Mac SettingsView.swift) =====
         No background of its own: the window is Mica with a Window.Backing layer (UI/Theme.cs), so the
         desktop softly shows through, and every card is a 4 % tint of the text colour. Header (title
         left, System/Light/Dark right) · three columns of cards (Stats heads the right one) · footer.

         Three columns (the Mac has two at 700 pt) because the Windows build carries four more cards
         (Microphone, Gaming, Corrections, Updates) and the window must fit David's 1600x1080 desktop:
         SettingsWindow clamps MaxHeight to the work area so the title-bar X can never go off-screen
         (§7 #33) and the outer ScrollViewer scrolls if a card ever overflows. Left = how dictation
         behaves (+ Appearance), middle = input, hotkeys and updates, right = your data (the Mac's split,
         balanced so the three columns end at about the same height).

         HorizontalScrollBarVisibility="Disabled" is REQUIRED: it gives the body a finite width so the
         star columns resolve. AutomationIds on the cards are the tour anchors (settings.*). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Header: title left, appearance picker right -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="JVoice" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Voice dictation controls" Style="{StaticResource Note}" Margin="0,1,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Style="{StaticResource SegmentTrack}" VerticalAlignment="Center"
                        AutomationProperties.AutomationId="settings.theme" AutomationProperties.Name="Appearance">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="Appearance" Style="{StaticResource IconSegment}" Content="&#xE770;"
                                     ToolTip="System" AutomationProperties.Name="System"
                                     IsChecked="{Binding IsAppearanceSystem, Mode=TwoWay}" />
                        <RadioButton GroupName="Appearance" Style="{StaticResource IconSegment}" Content="&#xE706;"
                                     ToolTip="Light" AutomationProperties.Name="Light"
                                     IsChecked="{Binding IsAppearanceLight, Mode=TwoWay}" />
                        <RadioButton GroupName="Appearance" Style="{StaticResource IconSegment}" Content="&#xE708;"
                                     ToolTip="Dark" AutomationProperties.Name="Dark"
                                     IsChecked="{Binding IsAppearanceDark, Mode=TwoWay}" />
                    </StackPanel>
                </Border>
                <!-- ⓘ: Replay Tour · Show Me ▸ · Keyboard Shortcuts (the InfoButton is set in code) -->
                <ContentControl x:Name="InfoHost" Margin="8,0,0,0" VerticalAlignment="Center" Focusable="False"
                                AutomationProperties.AutomationId="settings.help" />
                </StackPanel>
            </Grid>


            <!-- 2. Three columns -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ===================== LEFT: how dictation behaves ===================== -->
                <StackPanel Grid.Column="0">

                    <ui:SettingsCard HeaderText="Whisper Model" AutomationProperties.AutomationId="settings.model">
                        <StackPanel>
                            <Border Style="{StaticResource SegmentTrack}">
                                <UniformGrid Rows="1">
                                    <RadioButton Content="Tiny"  GroupName="Model" Style="{StaticResource SegmentLeft}"  IsChecked="{Binding IsTiny, Mode=TwoWay}" />
                                    <RadioButton Content="Base"  GroupName="Model" Style="{StaticResource SegmentMid}"   IsChecked="{Binding IsBase, Mode=TwoWay}" />
                                    <RadioButton Content="Small" GroupName="Model" Style="{StaticResource SegmentMid}"   IsChecked="{Binding IsSmall, Mode=TwoWay}" />
                                    <RadioButton Content="Large" GroupName="Model" Style="{StaticResource SegmentRight}" IsChecked="{Binding IsLarge, Mode=TwoWay}" />
                                </UniformGrid>
                            </Border>
                            <TextBlock Text="{Binding ModelGuidance}" Style="{StaticResource Note}" Margin="0,8,0,0" />

                            <!-- "Keep this on Large" (§7 #35): the warning glyph carries the orange; the extra
                                 caution line shows only when a smaller model is picked (IsLarge). -->
                            <Border CornerRadius="6" Background="{DynamicResource Input.Fill}" Padding="10,8" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontFamily="{StaticResource IconFont}" Text="&#xE7BA;" FontSize="14"
                                               Foreground="{DynamicResource Warning}" VerticalAlignment="Top" Margin="0,1,8,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource Note}">
                                            <Run FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}">Keep this on Large.</Run>
                                            <Run Text=" It's the most accurate, and on a GPU just as fast. Switch only for an older, CPU-only PC." />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource Note}" Foreground="{DynamicResource Text.Primary}" Margin="0,6,0,0"
                                                   Text="A smaller model may be less accurate &#8212; switch back unless you need it."
                                                   Visibility="{Binding IsLarge, Converter={StaticResource InverseBoolToVis}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ui:SettingsCard>

                    <ui:SettingsCard HeaderText="Processing" AutomationProperties.AutomationId="settings.processing">
                        <StackPanel>
                            <!-- Each row: a star text column (title + wrapping note) and an Auto switch column,
                                 so the note can never slide under the toggle. -->
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Developer Terms" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Fix coding terms: Node.js, GitHub, TypeScript, JSON, C#&#8230;" Style="{StaticResource Note}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource MonoSwitch}"
                                          AutomationProperties.Name="Developer Terms" IsChecked="{Binding DeveloperTermsEnabled, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Math Notation" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Spoken equations become symbols: x squared equals 4 &#8594; x&#178; = 4" Style="{StaticResource Note}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource MonoSwitch}"
                                          AutomationProperties.Name="Math Notation" IsChecked="{Binding MathNotationEnabled, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Remove Filler Words" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Strip um, uh, er, ah, hmm from output" Style="{StaticResource Note}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource MonoSwitch}"
                                          AutomationProperties.Name="Remove Filler Words" IsChecked="{Binding RemoveFillerWords, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Copy to Clipboard" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Copy the text instead of auto-pasting it" Style="{StaticResource Note}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource MonoSwitch}"
                                          AutomationProperties.Name="Copy to Clipboard" IsChecked="{Binding CopyToClipboardOnly, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </ui:SettingsCard>

                    <ui:SettingsCard HeaderText="Voice Style" AutomationProperties.AutomationId="settings.voiceStyle">
                        <Border Style="{StaticResource SegmentTrack}">
                            <UniformGrid Rows="1">
                                <RadioButton Content="Casual"      GroupName="Tone" Style="{StaticResource SegmentLeft}"  IsChecked="{Binding IsCasual, Mode=TwoWay}" />
                                <RadioButton Content="Formal"      GroupName="Tone" Style="{StaticResource SegmentMid}"   IsChecked="{Binding IsFormal, Mode=TwoWay}" />
                                <RadioButton Content="Very Casual" GroupName="Tone" Style="{StaticResource SegmentRight}" IsChecked="{Binding IsVeryCasual, Mode=TwoWay}" />
                            </UniformGrid>
                        </Border>
                    </ui:SettingsCard>

                    <ui:SettingsCard HeaderText="Language" AutomationProperties.AutomationId="settings.language">
                        <StackPanel>
                            <Border Style="{StaticResource SegmentTrack}">
                                <UniformGrid Rows="1">
                                    <RadioButton Content="English"  GroupName="Lang" Style="{StaticResource SegmentLeft}"  IsChecked="{Binding IsEnglish, Mode=TwoWay}" />
                                    <RadioButton Content="Romanian" GroupName="Lang" Style="{StaticResource SegmentRight}" IsChecked="{Binding IsRomanian, Mode=TwoWay}" />
                                </UniformGrid>
                            </Border>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Translate to English" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Speak the language above, paste English" Style="{StaticResource Note}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource MonoSwitch}"
                                          AutomationProperties.Name="Translate to English" IsChecked="{Binding TranslateToEnglish, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </ui:SettingsCard>


                    <!-- APPEARANCE — the Opacity setting shared by MacStats, JVoice and BetterScreenshot
                         (row 30); live: every window and the pill follow the slider. -->
                    <ui:SettingsCard HeaderText="Appearance" AutomationProperties.AutomationId="settings.appearance">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Opacity" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Default" Style="{StaticResource SubtleButton}" Click="OnOpacityDefault"
                                        ToolTip="Back to the standard look"
                                        IsEnabled="{Binding CanResetOpacity}" />
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Transparent" FontSize="11" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Style="{StaticResource FluentSlider}" Minimum="0" Maximum="1" Margin="8,0"
                                        SmallChange="0.05" LargeChange="0.1" AutomationProperties.Name="Opacity"
                                        Value="{Binding UiOpacity, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2" Text="Opaque" FontSize="11" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Style="{StaticResource Note}" Margin="0,6,0,0"
                                       Text="How much of what's behind JVoice shows through its windows and the recording pill." />
                        </StackPanel>
                    </ui:SettingsCard>
                </StackPanel>

                <!-- ===================== MIDDLE: input + shortcuts ===================== -->
                <StackPanel Grid.Column="2">

                    <!-- MICROPHONE — schema v5, §7 #46. The OS default capture endpoint is not reliably a
                         real microphone (virtual devices emit digital silence when their app isn't running);
                         picking it here fixes that inside JVoice without changing the OS-wide default. -->
                    <ui:SettingsCard HeaderText="Microphone" AutomationProperties.AutomationId="settings.microphone">
                        <StackPanel>
                            <ComboBox Style="{StaticResource MonoComboBox}" AutomationProperties.Name="Microphone"
                                      ItemsSource="{Binding InputDevices}"
                                      SelectedItem="{Binding SelectedInputDevice, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0"
                                       Text="Pick your real mic if dictation returns nothing &#8212; virtual mics (Voicemod, VB-Cable&#8230;) can hold the default and send silence." />
                        </StackPanel>
                    </ui:SettingsCard>

                    <ui:SettingsCard HeaderText="App Modes" AutomationProperties.AutomationId="settings.appModes">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Auto-switch by App" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Terminals, VS Code &amp; IDEs use Code mode automatically" Style="{StaticResource Note}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource MonoSwitch}"
                                          AutomationProperties.Name="Auto-switch by App" IsChecked="{Binding AppAwareModes, Mode=TwoWay}" />
                            </Grid>

                            <TextBlock Text="No rules yet. Pick one of your open apps (or type a name), choose a mode, then Add."
                                       Style="{StaticResource Note}" Margin="0,10,0,0"
                                       Visibility="{Binding HasAppModeRules, Converter={StaticResource InverseBoolToVis}}" />
                            <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto" Margin="-6,8,-6,0"
                                          Visibility="{Binding HasAppModeRules, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding AppModeRules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource HoverRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding AppMatch}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Mode}" FontSize="12" Margin="8,0,0,0"
                                                               Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" />
                                                    <Button Grid.Column="2" Style="{StaticResource PressableButton}" Margin="8,0,0,0"
                                                            Click="OnRemoveAppRule" Tag="{Binding}" ToolTip="Remove" AutomationProperties.Name="Remove"
                                                            FontFamily="{StaticResource IconFont}" Content="&#xE738;" FontSize="12"
                                                            Visibility="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource BoolToVis}}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <!-- Add row: searchable open-app picker + click-to-cycle mode chip + Add. -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <TextBox x:Name="AppRuleBox" Style="{StaticResource InputBox}" AutomationProperties.Name="App name"
                                             GotKeyboardFocus="OnAppRuleFocus" TextChanged="OnAppRuleTextChanged"
                                             KeyDown="OnAppRuleKeyDown" />
                                    <!-- Watermark (toggled in code-behind when the box is empty). -->
                                    <TextBlock x:Name="AppRuleWatermark" Text="Search your open apps&#8230;" FontSize="13"
                                               Foreground="{DynamicResource Text.Tertiary}" Margin="10,0,0,0"
                                               IsHitTestVisible="False" VerticalAlignment="Center" />
                                </Grid>
                                <!-- Filtered dropdown of currently-open apps. -->
                                <Popup x:Name="AppPickerPopup" PlacementTarget="{Binding ElementName=AppRuleBox}"
                                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                       Width="{Binding ActualWidth, ElementName=AppRuleBox}">
                                    <Border Background="{DynamicResource Popup.Fill}" BorderBrush="{DynamicResource Card.Hairline}"
                                            BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" Padding="2">
                                        <ListBox x:Name="AppPickerList" Background="Transparent" BorderThickness="0" MaxHeight="176"
                                                 SelectionChanged="OnAppPicked" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="8,4" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="row" Background="{TemplateBinding Background}" CornerRadius="4"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="row" Property="Background" Value="{DynamicResource Row.Hover}" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="row" Property="Background" Value="{DynamicResource Button.Fill}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Display}" FontSize="13" Foreground="{DynamicResource Text.Primary}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Exe}" FontSize="11" Foreground="{DynamicResource Text.Secondary}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </Popup>
                                <Button x:Name="AppRuleModeButton" Grid.Column="1" Style="{StaticResource SubtleButton}" Margin="6,0,0,0"
                                        MinWidth="64" Content="Code" Click="OnCycleAppRuleMode" ToolTip="Click to change the mode this rule applies" />
                                <Button Grid.Column="2" Content="Add" Style="{StaticResource SubtleButton}" Margin="6,0,0,0" Click="OnAddAppRule" />
                            </Grid>
                            <TextBlock x:Name="AppRuleNotice" Visibility="Collapsed" Style="{StaticResource Note}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Danger}" Margin="0,6,0,0"
                                       AutomationProperties.LiveSetting="Assertive" />
                        </StackPanel>
                    </ui:SettingsCard>

                    <ui:SettingsCard HeaderText="Keyboard Shortcut" AutomationProperties.AutomationId="settings.shortcut">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Toggle Recording" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                <ui:HotkeyRecorder x:Name="Recorder" Grid.Column="1" MinWidth="130" AutomationProperties.Name="Toggle Recording shortcut" />
                            </Grid>
                            <TextBlock x:Name="RecorderNotice" Visibility="Collapsed" Style="{StaticResource Note}"
                                       Foreground="{DynamicResource Danger}" Margin="0,6,0,0"
                                       AutomationProperties.LiveSetting="Assertive" />
                            <TextBlock Text="Default: Ctrl + Shift + Space" Style="{StaticResource Note}" Margin="0,6,0,0" />

                            <!-- Optional undo-last-paste chord (off by default; a global chord is swallowed
                                 system-wide, so it's opt-in — pick a rare combo). -->
                            <Rectangle Height="1" Fill="{DynamicResource Card.Hairline}" Margin="0,10,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Undo Last Paste" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                <ui:HotkeyRecorder x:Name="UndoRecorder" Grid.Column="1" MinWidth="110" Content="None"
                                                   AutomationProperties.Name="Undo Last Paste shortcut" />
                                <Button Grid.Column="2" Content="Clear" Style="{StaticResource SubtleButton}" Margin="6,0,0,0"
                                        Click="OnClearUndoHotkey"
                                        Visibility="{Binding HasUndoHotkey, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                            <TextBlock x:Name="UndoRecorderNotice" Visibility="Collapsed" Style="{StaticResource Note}"
                                       Foreground="{DynamicResource Danger}" Margin="0,6,0,0"
                                       AutomationProperties.LiveSetting="Assertive" />
                            <TextBlock Text="Optional &#8212; sends the app's Undo (Ctrl+Z) to reverse the last paste." Style="{StaticResource Note}" Margin="0,6,0,0" />
                        </StackPanel>
                    </ui:SettingsCard>

                    <ui:SettingsCard HeaderText="Gaming" AutomationProperties.AutomationId="settings.gaming">
                        <StackPanel>
                            <Border Style="{StaticResource SegmentTrack}">
                                <UniformGrid Rows="1">
                                    <RadioButton Content="Off"        GroupName="GameMode" Style="{StaticResource SegmentLeft}"  IsChecked="{Binding IsGameOff, Mode=TwoWay}" />
                                    <RadioButton Content="Balanced"   GroupName="GameMode" Style="{StaticResource SegmentMid}"   IsChecked="{Binding IsGameBalanced, Mode=TwoWay}" />
                                    <RadioButton Content="Aggressive" GroupName="GameMode" Style="{StaticResource SegmentRight}" IsChecked="{Binding IsGameAggressive, Mode=TwoWay}" />
                                </UniformGrid>
                            </Border>
                            <TextBlock Text="Pause the hotkey while a game is focused. Aggressive also pauses for any fullscreen app."
                                       Style="{StaticResource Note}" Margin="0,8,0,0" />
                        </StackPanel>
                    </ui:SettingsCard>


                    <!-- UPDATES — in-app version check + one-click update (§7 #36) -->
                    <ui:SettingsCard HeaderText="Updates" AutomationProperties.AutomationId="settings.updates">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Automatic Updates" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Check GitHub for a new version. No data is sent." Style="{StaticResource Note}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource MonoSwitch}"
                                          AutomationProperties.Name="Automatic Updates" IsChecked="{Binding CheckForUpdatesAutomatically, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource Text.Secondary}">
                                    <Run Text="Version " /><Run Text="{Binding Updates.CurrentVersionDisplay, Mode=OneWay}" />
                                </TextBlock>
                                <Button Grid.Column="1" Content="Check Now" Style="{StaticResource SubtleButton}" Click="OnCheckForUpdates"
                                        Visibility="{Binding Updates.CanCheck, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                            <TextBlock Text="{Binding Updates.StatusText}" Style="{StaticResource Note}" Margin="0,8,0,0"
                                       Visibility="{Binding Updates.HasStatus, Converter={StaticResource BoolToVis}}" />
                            <Button Content="Update Now" Style="{StaticResource AccentButton}" HorizontalAlignment="Left"
                                    Margin="0,8,0,0" Click="OnUpdateNow"
                                    Visibility="{Binding Updates.ShowUpdateButton, Converter={StaticResource BoolToVis}}" />
                            <!-- Eased download bar: no % text; the fill glides via UpdateCoordinator's
                                 smoothing timer and is full only when the download completes. -->
                            <Border x:Name="UpdateProgressTrack" Height="4" CornerRadius="2" Margin="0,10,0,2"
                                    Background="{DynamicResource Button.Pressed}" ClipToBounds="True"
                                    Visibility="{Binding Updates.ShowProgress, Converter={StaticResource BoolToVis}}">
                                <Border HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource Accent}">
                                    <Border.Width>
                                        <MultiBinding Converter="{StaticResource FractionToWidth}">
                                            <Binding Path="Updates.Progress" />
                                            <Binding Path="ActualWidth" ElementName="UpdateProgressTrack" />
                                        </MultiBinding>
                                    </Border.Width>
                                </Border>
                            </Border>
                        </StackPanel>
                    </ui:SettingsCard>
                </StackPanel>

                <!-- ===================== RIGHT: your data + the app ===================== -->
                <StackPanel Grid.Column="4">

                    <!-- STATS: the MacStats stat pattern (a big value over a caption). The Mac puts it full
                         width on top; here it heads the right column, which has the spare height, so the
                         whole panel fits a 1080-tall desktop without scrolling. -->
                    <ui:SettingsCard HeaderText="Stats" AutomationProperties.AutomationId="settings.stats">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding TotalWordsSpoken}" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center" />
                                <TextBlock Text="total words" FontSize="11" Foreground="{DynamicResource Text.Secondary}" HorizontalAlignment="Center" />
                            </StackPanel>
                            <Rectangle Grid.Column="1" Width="1" Height="36" Fill="{DynamicResource Card.Hairline}" />
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding AverageWpmDisplay}" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center" />
                                <TextBlock Text="avg WPM" FontSize="11" Foreground="{DynamicResource Text.Secondary}" HorizontalAlignment="Center" />
                            </StackPanel>
                            <Rectangle Grid.Column="3" Width="1" Height="36" Fill="{DynamicResource Card.Hairline}" />
                            <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding TimeSavedDisplay}" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center" />
                                <TextBlock Text="time saved" FontSize="11" Foreground="{DynamicResource Text.Secondary}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </ui:SettingsCard>

                    <!-- RECENT TRANSCRIPTS — read-only history of the last 30 dictations -->
                    <ui:SettingsCard HeaderText="Recent Transcripts" AutomationProperties.AutomationId="settings.transcripts">
                        <StackPanel>
                            <TextBlock Text="No transcripts yet." Style="{StaticResource EmptyNote}"
                                       Visibility="{Binding HasRecentTranscripts, Converter={StaticResource InverseBoolToVis}}" />
                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" Margin="-6,0,-6,0"
                                          Visibility="{Binding HasRecentTranscripts, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding RecentTranscripts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- One line; hover highlights it and reveals Copy + Remove. -->
                                            <Border Style="{StaticResource HoverRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Text}" FontSize="13" TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                                Visibility="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource BoolToVis}}">
                                                        <!-- Copy — flips to a checkmark for ~1.2s after a click -->
                                                        <Button Style="{StaticResource PressableButton}" Click="OnCopyTranscript"
                                                                Margin="6,0,0,0" ToolTip="Copy to clipboard" AutomationProperties.Name="Copy">
                                                            <Grid>
                                                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8C8;" FontSize="12"
                                                                           Visibility="{Binding JustCopied, Converter={StaticResource InverseBoolToVis}}" />
                                                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE73E;" FontSize="12"
                                                                           Visibility="{Binding JustCopied, Converter={StaticResource BoolToVis}}" />
                                                            </Grid>
                                                        </Button>
                                                        <Button Style="{StaticResource PressableButton}" Click="OnDeleteTranscript"
                                                                Margin="6,0,0,0" ToolTip="Remove" AutomationProperties.Name="Remove"
                                                                FontFamily="{StaticResource IconFont}" Content="&#xE738;" FontSize="12" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Button Content="Clear All" Style="{StaticResource SubtleDestructiveButton}"
                                    HorizontalAlignment="Right" Margin="0,8,0,0" Click="OnClearTranscripts"
                                    Visibility="{Binding HasRecentTranscripts, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </ui:SettingsCard>

                    <ui:SettingsCard HeaderText="Custom Words" AutomationProperties.AutomationId="settings.customWords">
                        <StackPanel>
                            <TextBlock Text="No custom words added." Style="{StaticResource EmptyNote}"
                                       Visibility="{Binding HasCustomWords, Converter={StaticResource InverseBoolToVis}}" />
                            <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto" Margin="-6,0,-6,0"
                                          Visibility="{Binding HasCustomWords, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding CustomWords}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource HoverRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <Button Grid.Column="1" Style="{StaticResource PressableButton}"
                                                            Click="OnRemoveWord" Tag="{Binding}" ToolTip="Remove" AutomationProperties.Name="Remove"
                                                            FontFamily="{StaticResource IconFont}" Content="&#xE738;" FontSize="12"
                                                            Visibility="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource BoolToVis}}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid>
                                    <TextBox x:Name="NewWordBox" Style="{StaticResource InputBox}" AutomationProperties.Name="New custom word"
                                             KeyDown="OnNewWordKeyDown" />
                                    <TextBlock Text="Add word (e.g. VS Code)" FontSize="13" Foreground="{DynamicResource Text.Tertiary}"
                                               Margin="10,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=NewWordBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Button Grid.Column="1" Content="Add" Style="{StaticResource SubtleButton}" Margin="6,0,0,0" Click="OnAddWord" />
                            </Grid>
                            <TextBlock x:Name="WordNotice" Visibility="Collapsed" Style="{StaticResource Note}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Danger}" Margin="0,6,0,0"
                                       AutomationProperties.LiveSetting="Assertive" />
                        </StackPanel>
                    </ui:SettingsCard>

                    <!-- CORRECTIONS — Windows-only; kept next to Custom Words -->
                    <ui:SettingsCard HeaderText="Corrections" AutomationProperties.AutomationId="settings.corrections">
                        <StackPanel>
                            <TextBlock Text="No corrections added." Style="{StaticResource EmptyNote}"
                                       Visibility="{Binding HasCorrections, Converter={StaticResource InverseBoolToVis}}" />
                            <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto" Margin="-6,0,-6,0"
                                          Visibility="{Binding HasCorrections, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding Corrections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource HoverRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                        <Run Text="{Binding From, Mode=OneWay}" /><Run Text="  &#x2192;  " Foreground="{DynamicResource Text.Secondary}" /><Run Text="{Binding To, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <Button Grid.Column="1" Style="{StaticResource PressableButton}"
                                                            Click="OnRemoveCorrection" Tag="{Binding}" ToolTip="Remove" AutomationProperties.Name="Remove"
                                                            FontFamily="{StaticResource IconFont}" Content="&#xE738;" FontSize="12"
                                                            Visibility="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource BoolToVis}}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <TextBox x:Name="CorrectionFromBox" Style="{StaticResource InputBox}" AutomationProperties.Name="Heard"
                                             KeyDown="OnCorrectionKeyDown" />
                                    <TextBlock Text="heard" FontSize="13" Foreground="{DynamicResource Text.Tertiary}"
                                               Margin="10,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=CorrectionFromBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <TextBlock Grid.Column="1" Text="&#x2192;" FontSize="13" Foreground="{DynamicResource Text.Secondary}"
                                           VerticalAlignment="Center" Margin="6,0,6,0" />
                                <Grid Grid.Column="2">
                                    <TextBox x:Name="CorrectionToBox" Style="{StaticResource InputBox}" AutomationProperties.Name="Replace with"
                                             KeyDown="OnCorrectionKeyDown" />
                                    <TextBlock Text="meant" FontSize="13" Foreground="{DynamicResource Text.Tertiary}"
                                               Margin="10,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=CorrectionToBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Button Grid.Column="3" Content="Add" Style="{StaticResource SubtleButton}" Margin="6,0,0,0" Click="OnAddCorrection" />
                            </Grid>
                            <TextBlock x:Name="CorrectionNotice" Visibility="Collapsed" Style="{StaticResource Note}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Danger}" Margin="0,6,0,0"
                                       AutomationProperties.LiveSetting="Assertive" />
                            <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0"
                                       Text="Replace a misheard word or phrase. Use the whole phrase (&#8220;web api&#8221; &#8594; &#8220;web app&#8221;) so other uses stay untouched." />
                        </StackPanel>
                    </ui:SettingsCard>

                    <!-- TOURS & TIPS (parity §10.6) — the opt-in switch + replay/reset, for every user -->
                    <ui:SettingsCard HeaderText="Tours &amp; Tips" AutomationProperties.AutomationId="settings.tours">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Show Me Around" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Point out each part the first time you use it." Style="{StaticResource Note}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource MonoSwitch}"
                                          AutomationProperties.Name="Show Me Around" IsChecked="{Binding ShowMeAroundEnabled, Mode=TwoWay}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Replay Welcome Tour" Style="{StaticResource SubtleButton}" Click="OnReplayWelcomeTour" />
                                <Button Content="Reset All Tours" Style="{StaticResource SubtleButton}" Margin="8,0,0,0" Click="OnResetAllTours" />
                            </StackPanel>
                        </StackPanel>
                    </ui:SettingsCard>
                </StackPanel>
            </Grid>

            <!-- 3. Footer: the destructive actions as small red buttons (MacStats footer) -->
            <Grid Grid.Row="2" Margin="0,2,0,0">
                <Button Content="Restore Default Settings&#8230;" Style="{StaticResource SubtleDestructiveButton}"
                        HorizontalAlignment="Left" Click="OnRestoreDefaults" />
                <Button Content="Quit JVoice" Style="{StaticResource SubtleDestructiveButton}"
                        HorizontalAlignment="Right" Click="OnQuit" />
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
